{
  "ws": {
    "entryUrl": "https://web.whatsapp.com/",
    "session": "non-persistent",
    "defaultTargetLanguage": "中文",
    "translationEnabled": true,
    "receiveTranslationEnabled": true,
    "sendTranslationEnabled": true,
    "showOriginal": true,
    "aiEnabled": true,
    "autoSend": false
  },
  "security": {
    "readCookies": false,
    "savePassword": false,
    "saveQrCode": false,
    "readSecretsFromLogs": false
  },
  "notes": [
    "此文件只是配置说明示例，不包含 API Key、密码、Cookie 或 Token。",
    "WS 页面只允许用户自行登录；自动同步和自动发送没有启用。"
  ]
}
