<Window
    x:Class="Zhike.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootShell" MinWidth="820" MinHeight="540"
          Background="{StaticResource ZhikePageBackgroundBrush}"
          SizeChanged="OnShellSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="57" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource ZhikeSurfaceBrush}"
                BorderBrush="{StaticResource ZhikeLineBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="18,0" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="9">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource ZhikeNavyBrush}">
                        <TextBlock Text="知" Foreground="White" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="-2">
                        <TextBlock Text="知客" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource ZhikeNavyBrush}" />
                        <TextBlock Text="运营工作台" FontSize="10" Foreground="{StaticResource ZhikeMutedTextBrush}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="业务数据 · AI 跟进 · WS 工作台"
                           VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource ZhikeMutedTextBrush}" />
                <Border Grid.Column="2" Background="#E7F8F3" CornerRadius="14" Padding="10,4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource ZhikeTealBrush}" />
                        <TextBlock Text="本机优先 · 已连接" FontSize="10" Foreground="#0A806E" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <NavigationView Grid.Row="1" x:Name="RootNavigation" IsBackEnabled="False"
                        IsSettingsVisible="False" IsPaneToggleButtonVisible="True"
                        PaneDisplayMode="LeftCompact" CompactPaneLength="68" OpenPaneLength="244"
                        SelectionChanged="OnNavigationChanged"
                        Background="{StaticResource ZhikePageBackgroundBrush}">
            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="工作" />
                <NavigationViewItem Content="今日工作台" Tag="home" Icon="Home" />
                <NavigationViewItem Content="快速录入" Tag="import" Icon="Add" />
                <NavigationViewItem Content="任务中心" Tag="operations" Icon="Calendar" />
                <NavigationViewItem Content="阶段看板" Tag="stage-board" Icon="ViewAll" />

                <NavigationViewItemHeader Content="客户" />
                <NavigationViewItem Content="客户中心" Tag="customers" Icon="Contact" />
                <NavigationViewItem Content="分类视图" Tag="segments" Icon="List" />
                <NavigationViewItem Content="热聊管理" Tag="hot" Icon="Message" />
                <NavigationViewItem Content="群组管理" Tag="groups" Icon="People" />
                <NavigationViewItem Content="VIP 管理" Tag="vip" Icon="Favorite" />

                <NavigationViewItemHeader Content="业务数据" />
                <NavigationViewItem Content="跟票管理" Tag="tickets" Icon="Target" />
                <NavigationViewItem Content="报名统计" Tag="registrations" Icon="ContactInfo" />
                <NavigationViewItem Content="入金管理" Tag="deposits" Icon="Calculator" />
                <NavigationViewItem Content="统计分析" Tag="analytics" Icon="FourBars" />

                <NavigationViewItemHeader Content="系统管理" />
                <NavigationViewItem Content="WS 工作台" Tag="ws" Icon="Message" />
                <NavigationViewItem x:Name="gptAssistantNav" Content="GPT 运营助手" Tag="gpt" Icon="Important" />
                <NavigationViewItem Content="AI 跟进提醒" Tag="ai" Icon="Important" />
                <NavigationViewItem Content="本地自动化" Tag="automation" Icon="Sync" />
                <NavigationViewItem Content="数据治理" Tag="quality" Icon="ProtectedDocument" />
                <NavigationViewItem Content="数据中心" Tag="data" Icon="Library" />
                <NavigationViewItem Content="操作记录" Tag="activity" Icon="Clock" />
                <NavigationViewItem Content="回收站" Tag="recycle" Icon="Delete" />
                <NavigationViewItem Content="系统设置" Tag="settings" Icon="Setting" />
                <NavigationViewItem Content="手机号登记" Tag="phone-registry" Icon="Phone" />
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <Border Background="{StaticResource ZhikeSurfaceMutedBrush}" CornerRadius="8" Margin="8,4" Padding="10,7">
                    <TextBlock Text="数据仅保存到本机/私有服务" FontSize="10" Foreground="{StaticResource ZhikeMutedTextBrush}" TextWrapping="Wrap" />
                </Border>
            </NavigationView.PaneFooter>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
