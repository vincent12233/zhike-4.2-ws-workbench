<Window
    x:Class="Zhike.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootShell" MinWidth="820" MinHeight="540"
          Background="{StaticResource ZhikePageBackgroundBrush}"
          SizeChanged="OnShellSizeChanged">
        <!-- The embedded workbench owns the only header, sidebar and route
             state in 6.0. A second hidden NavigationView would keep the old
             fallback navigation alive and could make routes diverge. -->
        <Frame x:Name="ContentFrame" />
    </Grid>
</Window>
