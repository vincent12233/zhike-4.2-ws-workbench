<Page x:Class="Zhike.Desktop.Views.CustomersPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="客户中心" FontSize="28" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBox Width="220" PlaceholderText="搜索姓名、号码、标签" />
            <ComboBox Width="160" PlaceholderText="客户阶段" />
            <Button Content="刷新" />
            <Button Content="导出" />
        </StackPanel>
        <ListView Grid.Row="2" x:Name="CustomersList">
            <ListViewItem Content="客户资料由 API 分页加载；AI 只补充空字段，冲突进入待确认。" />
        </ListView>
    </Grid>
</Page>
