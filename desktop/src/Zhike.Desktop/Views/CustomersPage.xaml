<Page x:Class="Zhike.Desktop.Views.CustomersPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="客户中心" FontSize="28" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="SearchBox" Width="220" PlaceholderText="搜索姓名、号码、标签" TextChanged="OnSearchChanged" />
            <ComboBox x:Name="StageFilter" Width="160" PlaceholderText="客户阶段" SelectionChanged="OnStageChanged">
                <ComboBoxItem Content="全部阶段" Tag="" />
                <ComboBoxItem Content="新客户" Tag="新客户" />
                <ComboBoxItem Content="跟进中" Tag="跟进中" />
                <ComboBoxItem Content="已成交" Tag="已成交" />
            </ComboBox>
            <Button Content="刷新" Click="RefreshCustomers" />
            <Button Content="导出" Click="ExportCustomers" />
        </StackPanel>
        <InfoBar Grid.Row="2" x:Name="CustomersStatus" IsOpen="False" />
        <Grid Grid.Row="3">
            <ListView x:Name="CustomersList">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="16" Padding="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="140"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding Phone}" />
                            <TextBlock Grid.Column="2" Text="{Binding Stage}" />
                            <TextBlock Grid.Column="3" Text="{Binding ProductInterest}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="CustomersEmptyState" Text="暂无客户数据。" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            <ProgressRing x:Name="CustomersLoading" IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
