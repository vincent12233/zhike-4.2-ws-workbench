<Page x:Class="Zhike.Desktop.Views.HomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="知客工作台" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="保留 4.4.24 业务口径的原生桌面工作台" Opacity="0.72" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <InfoBar Grid.Column="0" Title="客户" Message="从服务端加载" IsOpen="True" />
                <InfoBar Grid.Column="1" Title="待跟进" Message="AI 分析后提醒" IsOpen="True" />
                <InfoBar Grid.Column="2" Title="同步状态" Message="离线队列可恢复" IsOpen="True" />
            </Grid>
            <TextBlock Text="所有新增功能都通过版本化 API 与 PostgreSQL 对账，桌面端断网时保留本地待提交队列。" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
