<Page x:Class="Zhike.Desktop.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource ZhikePageBackgroundBrush}">
    <ScrollViewer Padding="38,30">
        <StackPanel MaxWidth="1120" HorizontalAlignment="Center" Spacing="18">
            <Button Content="‹  返回知客工作台" HorizontalAlignment="Left" Click="ReturnToWorkspace" />
            <TextBlock Text="本机服务诊断" FontSize="34" FontWeight="SemiBold" />
            <TextBlock Text="知客只使用本机 SQLite 服务。此页面用于检查桌面服务和数据目录，不连接 Docker 或远程服务器。"
                       Foreground="{StaticResource ZhikeMutedTextBrush}" TextWrapping="Wrap" />
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource ZhikeSurfaceBrush}" BorderBrush="{StaticResource ZhikeLineBrush}" BorderThickness="1" CornerRadius="14" Padding="18"><StackPanel><TextBlock Text="存储" Foreground="{StaticResource ZhikeMutedTextBrush}" /><TextBlock Text="SQLite 本机数据库" FontSize="18" Margin="0,6,0,0" /></StackPanel></Border>
                <Border Grid.Column="1" Background="{StaticResource ZhikeSurfaceBrush}" BorderBrush="{StaticResource ZhikeLineBrush}" BorderThickness="1" CornerRadius="14" Padding="18"><StackPanel><TextBlock Text="网络" Foreground="{StaticResource ZhikeMutedTextBrush}" /><TextBlock Text="可离线使用" FontSize="18" Margin="0,6,0,0" /></StackPanel></Border>
                <Border Grid.Column="2" Background="{StaticResource ZhikeSurfaceBrush}" BorderBrush="{StaticResource ZhikeLineBrush}" BorderThickness="1" CornerRadius="14" Padding="18"><StackPanel><TextBlock Text="WS 与 AI" Foreground="{StaticResource ZhikeMutedTextBrush}" /><TextBlock Text="登录后按需运行" FontSize="18" Margin="0,6,0,0" /></StackPanel></Border>
            </Grid>
            <Border Background="{StaticResource ZhikeSurfaceBrush}" BorderBrush="{StaticResource ZhikeLineBrush}" BorderThickness="1" CornerRadius="16" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="本机数据服务" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="服务状态" Foreground="{StaticResource ZhikeMutedTextBrush}" />
                    <TextBlock x:Name="ServiceStatusText" Text="正在检查…" FontSize="18" TextWrapping="Wrap" />
                    <TextBlock x:Name="ServiceDetailText" Foreground="{StaticResource ZhikeMutedTextBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="检查本机服务" Click="CheckLocalService" />
                        <Button Content="打开数据中心" Click="OpenDataCenter" Background="{StaticResource ZhikeTealBrush}" Foreground="White" />
                        <Button Content="返回工作台" Click="ReturnToWorkspace" />
                    </StackPanel>
                    <InfoBar x:Name="ServiceStatusBar" IsOpen="False" />
                </StackPanel>
            </Border>
            <InfoBar Title="数据保护" Message="客户资料、WS 会话、AI 分析和跟进提醒均保存在本机应用数据目录。请在数据中心定期导出完整 JSON 备份；卸载安装包不会删除该目录。" IsOpen="True" Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
