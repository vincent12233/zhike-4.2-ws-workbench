<Page x:Class="Zhike.Desktop.Views.LegacyUiHostPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ZhikePageBackgroundBrush}">
    <Grid x:Name="Root" RowSpacing="8" Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="HostBorder" Grid.Row="0"
                Background="{ThemeResource ZhikeSurfaceBrush}"
                BorderBrush="{ThemeResource ZhikeLineBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid x:Name="WebViewHost" SizeChanged="OnWebViewHostSizeChanged">
                <Canvas x:Name="WsOverlayLayer" Visibility="Collapsed" IsHitTestVisible="False"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" UseLayoutRounding="True">
                    <Border x:Name="WsOverlayBorder" Background="Transparent" BorderThickness="0" CornerRadius="0">
                        <Grid x:Name="WsOverlayHost" />
                    </Border>
                </Canvas>
                <!-- Keep a real, non-interactive viewport for the hidden
                     collector. Collapsing this surface makes WhatsApp report
                     no virtualized scroll geometry, so the collector layer is
                     laid out offscreen with zero opacity instead. -->
                <Canvas x:Name="WsCollectorLayer" Visibility="Visible" IsHitTestVisible="False"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" UseLayoutRounding="True">
                    <Grid x:Name="WsCollectorHost" Width="1280" Height="900"
                          Background="Transparent" IsHitTestVisible="False" Opacity="0" />
                </Canvas>
            </Grid>
        </Border>
        <InfoBar x:Name="HostStatus" Grid.Row="1" IsOpen="False"
                 Severity="Informational" IsClosable="False"
                 Message="知客页面正在连接本机服务。" />
        <StackPanel x:Name="HostActions" Grid.Row="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Visibility="Collapsed">
            <Button Content="重试加载" Click="RetryHost" />
            <Button Content="查看诊断" Click="ShowHostDiagnostics" />
        </StackPanel>
    </Grid>
</Page>
