<Page x:Class="Zhike.Desktop.Views.LegacyUiHostPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource ZhikePageBackgroundBrush}">
    <Grid x:Name="Root" RowSpacing="8" Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="HostBorder" Grid.Row="0"
                Background="{StaticResource ZhikeSurfaceBrush}"
                BorderBrush="{StaticResource ZhikeLineBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid x:Name="WebViewHost" />
        </Border>
        <InfoBar x:Name="HostStatus" Grid.Row="1" IsOpen="False"
                 Severity="Informational" IsClosable="False"
                 Message="知客页面正在连接本机服务。" />
    </Grid>
</Page>
