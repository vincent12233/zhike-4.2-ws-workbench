<Page x:Class="Zhike.Desktop.Views.WsWorkbenchPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="WorkbenchRoot" Padding="10" RowSpacing="6" SizeChanged="OnWorkbenchSizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="WS 工作台" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="个人账号 · 实时采集与 AI 跟进" VerticalAlignment="Center" FontSize="10" Opacity="0.64" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                <Button Content="收起会话" Click="ToggleLeftPane" />
                <Button Grid.Column="2" Content="收起辅助" Click="ToggleRightPane" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftPaneColumn" Width="224"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="RightPaneColumn" Width="340"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" x:Name="LeftPane" Spacing="8">
                <TextBlock Text="WS 账号" FontSize="18" FontWeight="SemiBold" />
                <Button Content="添加账号" Click="AddAccount" />
                <TextBlock x:Name="AccountsEmptyState" Text="还没有添加 WS 账号。添加后每个账号使用独立登录分区。" TextWrapping="Wrap" Opacity="0.72" />
                <ListView x:Name="AccountsList" SelectionChanged="OnAccountChanged" DisplayMemberPath="DisplayName" />
                <TextBlock x:Name="AccountStatusText" Text="未连接" Opacity="0.72" />
                <TextBlock Text="会话列表由账号级 checkpoint 持续采集，不需要逐个打开会话。" TextWrapping="Wrap" Opacity="0.72" />
            </StackPanel>
            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="8">
                <Grid x:Name="WebViewHost" />
            </Border>
            <ScrollViewer Grid.Column="2" x:Name="RightPane">
                <StackPanel Spacing="12">
                    <TextBlock Text="翻译与 AI 辅助" FontSize="18" FontWeight="SemiBold" />
                    <ToggleSwitch Header="翻译" IsOn="True" />
                    <ToggleSwitch Header="AI 分析" IsOn="True" />
                    <Button Content="分析当前会话" />
                    <InfoBar Title="同步状态" Message="只处理用户在 WS 中已授权可见的内容。" IsOpen="True" />
                    <TextBlock Text="客户摘要、意向、来源、年龄、职业、产品兴趣和预算会写入客户库的空字段；冲突进入待确认。" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
