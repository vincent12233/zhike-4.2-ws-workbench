<Page x:Class="Zhike.Desktop.Views.ImportPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="14">
            <TextBlock Text="快速录入与智能导入" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="列顺序可以变化；系统根据表头、样例值和页面上下文识别渠道、状态、登记日期、下次跟进日期、股票、方向、跟票、入金、群组与 VIP。" TextWrapping="Wrap" />
            <TextBox x:Name="SourceNameBox" Header="来源名称" PlaceholderText="例如：客户清单.csv" />
            <ComboBox x:Name="ImportTargetBox" Header="导入目标（默认自动识别）" SelectedIndex="0">
                <ComboBoxItem Content="自动识别（推荐）" Tag="auto" />
                <ComboBoxItem Content="客户中心（只写客户资料）" Tag="customer" />
                <ComboBoxItem Content="跟票业务" Tag="ticket" />
                <ComboBoxItem Content="入金业务" Tag="deposit" />
                <ComboBoxItem Content="混合业务（按行分流）" Tag="mixed" />
            </ComboBox>
            <TextBox x:Name="CsvInput" Header="CSV 内容（可粘贴）" PlaceholderText="姓名,手机号码,登记日期&#x0a;张三,13800000000,2026-11-08" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="预览 CSV" HorizontalAlignment="Stretch" Click="PreviewImport" />
                <Button Grid.Column="1" Content="提交当前批次" HorizontalAlignment="Stretch" Click="CommitImport" IsEnabled="False" x:Name="CommitButton" />
            </Grid>
            <InfoBar Title="日期字段" Message="登记日期与下次跟进日期独立保存，缺失时保持为空，不用当天日期替代。" IsOpen="True" Severity="Informational" />
            <InfoBar x:Name="ImportStatus" IsOpen="False" />
            <ProgressRing x:Name="ImportLoading" IsActive="False" HorizontalAlignment="Center" />
            <ListView x:Name="PreviewList">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="14" Padding="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="110"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding RowNumber}" />
                            <TextBlock Grid.Column="1" Text="{Binding Confidence}" />
                            <TextBlock Grid.Column="2" Text="待确认" />
                            <TextBlock Grid.Column="3" Text="{Binding Classified}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="ImportEmptyState" Text="粘贴 CSV 后点击预览，识别结果会显示在这里。" Visibility="Visible" />
        </StackPanel>
    </ScrollViewer>
</Page>
