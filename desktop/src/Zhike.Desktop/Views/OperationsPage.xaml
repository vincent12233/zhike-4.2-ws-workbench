<Page x:Class="Zhike.Desktop.Views.OperationsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="运营工作台" FontSize="28" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="ProductFilter" Width="180" PlaceholderText="股票代码" TextChanged="OnProductFilterChanged" />
            <ComboBox x:Name="DirectionFilter" Width="140" PlaceholderText="方向" SelectionChanged="OnDirectionChanged">
                <ComboBoxItem Content="全部方向" Tag="" />
                <ComboBoxItem Content="买入" Tag="买入" />
                <ComboBoxItem Content="卖出" Tag="卖出" />
            </ComboBox>
            <Button Content="刷新" Click="RefreshOperations" />
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <Pivot x:Name="OperationsPivot" Grid.Row="0" SelectionChanged="OnPivotChanged">
                <PivotItem Header="跟票" Tag="ticket"><TextBlock Text="股票代码、买入/卖出方向和日期组成独立记录；同一客户的不同股票不会合并。" TextWrapping="Wrap" /></PivotItem>
                <PivotItem Header="入金" Tag="deposit"><TextBlock Text="同一客户可以有多条不同日期、金额和币种的入金记录；记录沿用服务端 business-records 数据源。" TextWrapping="Wrap" /></PivotItem>
                <PivotItem Header="VIP" Tag="vip"><TextBlock Text="按 VIP 编号归档客户，并与现有客户库同步；列表按服务端记录实时刷新。" TextWrapping="Wrap" /></PivotItem>
                <PivotItem Header="任务与看板" Tag="followup"><TextBlock Text="任务列表和阶段看板共享同一状态源，拖动后即时刷新统计与客户阶段。" TextWrapping="Wrap" /></PivotItem>
                <PivotItem Header="统计" Tag="stats"><StackPanel Spacing="10"><TextBlock Text="统计" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="StatisticsText" Text="统计口径沿用 4.4.24 黄金快照。"/></StackPanel></PivotItem>
            </Pivot>
            <ListView x:Name="OperationsList" Grid.Row="1">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="14" Padding="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ProductCode}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding Direction}" />
                            <TextBlock Grid.Column="2" Text="{Binding BusinessDate}" />
                            <TextBlock Grid.Column="3" Text="{Binding CustomerId}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="OperationsEmptyState" Grid.Row="1" Text="当前筛选暂无记录。" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            <ProgressRing x:Name="OperationsLoading" Grid.Row="1" IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <InfoBar x:Name="OperationsStatus" Grid.Row="1" IsOpen="False" VerticalAlignment="Top" />
        </Grid>
    </Grid>
</Page>
