<Page x:Class="Zhike.Desktop.Views.AiFollowupPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="AI 跟进提醒" FontSize="28" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="StateFilter" Width="160" PlaceholderText="提醒状态" SelectionChanged="OnStateChanged">
                <ComboBoxItem Content="全部状态" Tag="" />
                <ComboBoxItem Content="待处理" Tag="pending" />
                <ComboBoxItem Content="已完成" Tag="completed" />
            </ComboBox>
            <Button Content="刷新提醒" Click="RefreshFollowups" />
            <ToggleButton x:Name="HighIntentToggle" Content="仅看高意向" Checked="OnHighIntentChanged" Unchecked="OnHighIntentChanged" />
        </StackPanel>
        <InfoBar Grid.Row="2" x:Name="FollowupStatus" IsOpen="False" />
        <Pivot Grid.Row="3">
            <PivotItem Header="跟进提醒">
              <Grid>
                <ListView x:Name="FollowupsList">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="14" Padding="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding Priority}" />
                            <TextBlock Grid.Column="3" Text="{Binding DueAt}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="FollowupEmptyState" Text="暂无待跟进提醒。" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                <ProgressRing x:Name="FollowupLoading" IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </PivotItem>
            <PivotItem Header="AI 任务">
              <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ComboBox x:Name="JobStateFilter" Width="150" SelectionChanged="OnJobStateChanged">
                    <ComboBoxItem Content="全部任务" Tag=""/>
                    <ComboBoxItem Content="等待处理" Tag="pending"/>
                    <ComboBoxItem Content="重试中" Tag="retrying"/>
                    <ComboBoxItem Content="永久失败" Tag="dead"/>
                    <ComboBoxItem Content="已完成" Tag="succeeded"/>
                  </ComboBox>
                  <Button Content="刷新任务" Click="RefreshJobs"/>
                  <Button Content="重试失败任务" Click="RetryFailedJobs"/>
                </StackPanel>
                <ListView Grid.Row="1" x:Name="JobsList">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnSpacing="12" Padding="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="90"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding JobType}"/>
                        <TextBlock Grid.Column="1" Text="{Binding State}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Attempts}"/>
                        <TextBlock Grid.Column="3" Text="{Binding LastError}" TextTrimming="CharacterEllipsis"/>
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
              </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
