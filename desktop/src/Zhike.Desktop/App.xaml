<Application
    x:Class="Zhike.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

        <!-- Zhike visual tokens: keep the native shell close to the existing
             Electron application instead of falling back to default WinUI
             blue/gray controls.  These are intentionally local resources so
             the desktop client can be restyled without changing business
             pages or API behaviour. -->
        <SolidColorBrush x:Key="ZhikePageBackgroundBrush" Color="#F4F7FB" />
        <SolidColorBrush x:Key="ZhikeSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ZhikeSurfaceMutedBrush" Color="#F5F8FC" />
        <SolidColorBrush x:Key="ZhikeNavyBrush" Color="#203449" />
        <SolidColorBrush x:Key="ZhikeNavySecondaryBrush" Color="#29445D" />
        <SolidColorBrush x:Key="ZhikeTealBrush" Color="#0EA991" />
        <SolidColorBrush x:Key="ZhikeBlueBrush" Color="#2B79D3" />
        <SolidColorBrush x:Key="ZhikeTextBrush" Color="#203449" />
        <SolidColorBrush x:Key="ZhikeMutedTextBrush" Color="#6B7F92" />
        <SolidColorBrush x:Key="ZhikeLineBrush" Color="#DCE6EF" />
        <SolidColorBrush x:Key="ZhikeSuccessBrush" Color="#167A52" />
        <SolidColorBrush x:Key="ZhikeSuccessBackgroundBrush" Color="#E7F6EE" />
        <SolidColorBrush x:Key="ZhikeWarningBrush" Color="#9A6410" />
        <SolidColorBrush x:Key="ZhikeWarningBackgroundBrush" Color="#FFF2D8" />
        <SolidColorBrush x:Key="ZhikeDangerBrush" Color="#A23A32" />
        <SolidColorBrush x:Key="ZhikeDangerBackgroundBrush" Color="#FFEAE7" />
        <SolidColorBrush x:Key="ZhikeAiBrush" Color="#7357C7" />
        <SolidColorBrush x:Key="ZhikeAiBackgroundBrush" Color="#F0EBFF" />

        <Style TargetType="Page">
            <Setter Property="Background" Value="{StaticResource ZhikePageBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ZhikeTextBrush}" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ZhikeTextBrush}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ZhikeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ZhikeNavyBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ZhikeLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ZhikeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ZhikeTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ZhikeLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource ZhikeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ZhikeTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ZhikeLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource ZhikeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ZhikeTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ZhikeLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource ZhikeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ZhikeNavyBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ZhikeLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="36" />
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="{StaticResource ZhikeSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ZhikeLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="6" />
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style TargetType="InfoBar">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
