<Application
    x:Class="Zhike.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

        <!-- Zhike visual tokens: keep the native shell close to the existing
             Electron application instead of falling back to default WinUI
             blue/gray controls.  These are intentionally local resources so
             the desktop client can be restyled without changing business
             pages or API behaviour. -->
        <SolidColorBrush x:Key="ZhikePageBackgroundBrush" Color="#F3F7FA" />
        <SolidColorBrush x:Key="ZhikeSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ZhikeSurfaceMutedBrush" Color="#F7F9FB" />
        <SolidColorBrush x:Key="ZhikeNavyBrush" Color="#172033" />
        <SolidColorBrush x:Key="ZhikeNavySecondaryBrush" Color="#202B40" />
        <SolidColorBrush x:Key="ZhikeTealBrush" Color="#0CBCA4" />
        <SolidColorBrush x:Key="ZhikeBlueBrush" Color="#4C7CF3" />
        <SolidColorBrush x:Key="ZhikeTextBrush" Color="#202939" />
        <SolidColorBrush x:Key="ZhikeMutedTextBrush" Color="#718096" />
        <SolidColorBrush x:Key="ZhikeLineBrush" Color="#DDE7EF" />

        <Style TargetType="Page">
            <Setter Property="Background" Value="{StaticResource ZhikePageBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ZhikeTextBrush}" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ZhikeTextBrush}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ZhikeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ZhikeNavyBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ZhikeLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ZhikeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ZhikeTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ZhikeLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource ZhikeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ZhikeTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ZhikeLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource ZhikeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ZhikeTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ZhikeLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource ZhikeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ZhikeNavyBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ZhikeLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="36" />
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="{StaticResource ZhikeSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ZhikeLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="6" />
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

            <Style TargetType="InfoBar">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,2,0,2" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
