<Application
    x:Class="Zhike.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

        <!-- Native startup, host-error controls and surfaces use the Windows
             theme. The embedded workspace retains its own existing palette
             preference; this resource-only change adds no theme IPC. -->
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="ZhikePageBackgroundBrush" Color="#F7F9FC" />
                <SolidColorBrush x:Key="ZhikeSurfaceBrush" Color="#FFFFFF" />
                <SolidColorBrush x:Key="ZhikeSurfaceMutedBrush" Color="#F1F4F9" />
                <SolidColorBrush x:Key="ZhikeNavyBrush" Color="#1E2F50" />
                <SolidColorBrush x:Key="ZhikeNavySecondaryBrush" Color="#4C6080" />
                <SolidColorBrush x:Key="ZhikeTealBrush" Color="#006972" />
                <SolidColorBrush x:Key="ZhikeBlueBrush" Color="#2854BE" />
                <SolidColorBrush x:Key="ZhikeTextBrush" Color="#1E2F50" />
                <SolidColorBrush x:Key="ZhikeMutedTextBrush" Color="#4C6080" />
                <SolidColorBrush x:Key="ZhikeLineBrush" Color="#B9CEE8" />
                <SolidColorBrush x:Key="ZhikeSuccessBrush" Color="#126842" />
                <SolidColorBrush x:Key="ZhikeSuccessBackgroundBrush" Color="#D9F1E9" />
                <SolidColorBrush x:Key="ZhikeWarningBrush" Color="#874304" />
                <SolidColorBrush x:Key="ZhikeWarningBackgroundBrush" Color="#FFDFB8" />
                <SolidColorBrush x:Key="ZhikeDangerBrush" Color="#9B2844" />
                <SolidColorBrush x:Key="ZhikeDangerBackgroundBrush" Color="#FFE0E5" />
                <SolidColorBrush x:Key="ZhikeAiBrush" Color="#5E2A9F" />
                <SolidColorBrush x:Key="ZhikeAiBackgroundBrush" Color="#E3D6FF" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Dark">
                <SolidColorBrush x:Key="ZhikePageBackgroundBrush" Color="#10182B" />
                <SolidColorBrush x:Key="ZhikeSurfaceBrush" Color="#17233B" />
                <SolidColorBrush x:Key="ZhikeSurfaceMutedBrush" Color="#1C2B46" />
                <SolidColorBrush x:Key="ZhikeNavyBrush" Color="#EEF2FF" />
                <SolidColorBrush x:Key="ZhikeNavySecondaryBrush" Color="#B0BDD8" />
                <SolidColorBrush x:Key="ZhikeTealBrush" Color="#70D6CB" />
                <SolidColorBrush x:Key="ZhikeBlueBrush" Color="#9CB7FF" />
                <SolidColorBrush x:Key="ZhikeTextBrush" Color="#EEF2FF" />
                <SolidColorBrush x:Key="ZhikeMutedTextBrush" Color="#B0BDD8" />
                <SolidColorBrush x:Key="ZhikeLineBrush" Color="#344561" />
                <SolidColorBrush x:Key="ZhikeSuccessBrush" Color="#7EE3AC" />
                <SolidColorBrush x:Key="ZhikeSuccessBackgroundBrush" Color="#123A2D" />
                <SolidColorBrush x:Key="ZhikeWarningBrush" Color="#FFD3A1" />
                <SolidColorBrush x:Key="ZhikeWarningBackgroundBrush" Color="#4A3429" />
                <SolidColorBrush x:Key="ZhikeDangerBrush" Color="#FFB9C9" />
                <SolidColorBrush x:Key="ZhikeDangerBackgroundBrush" Color="#512D42" />
                <SolidColorBrush x:Key="ZhikeAiBrush" Color="#E0C9FF" />
                <SolidColorBrush x:Key="ZhikeAiBackgroundBrush" Color="#3E2C68" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="HighContrast">
                <SolidColorBrush x:Key="ZhikePageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="ZhikeSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="ZhikeSurfaceMutedBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="ZhikeNavyBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="ZhikeNavySecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="ZhikeTealBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="ZhikeBlueBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="ZhikeTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="ZhikeMutedTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="ZhikeLineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="ZhikeSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="ZhikeSuccessBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="ZhikeWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="ZhikeWarningBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="ZhikeDangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="ZhikeDangerBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                <SolidColorBrush x:Key="ZhikeAiBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                <SolidColorBrush x:Key="ZhikeAiBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>

        <Style TargetType="Page">
            <Setter Property="Background" Value="{ThemeResource ZhikePageBackgroundBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource ZhikeTextBrush}" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource ZhikeTextBrush}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource ZhikeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource ZhikeNavyBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ZhikeLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{ThemeResource ZhikeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource ZhikeTextBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ZhikeLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{ThemeResource ZhikeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource ZhikeTextBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ZhikeLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{ThemeResource ZhikeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource ZhikeTextBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ZhikeLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="{ThemeResource ZhikeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource ZhikeNavyBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ZhikeLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="36" />
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="{ThemeResource ZhikeSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ZhikeLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="6" />
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style TargetType="InfoBar">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
