POSTGRES_DB=zhike
POSTGRES_USER=zhike_app
POSTGRES_PASSWORD=replace-with-a-local-secret
ZHike_APP_VERSION=5.1.0
ZHike_SCHEMA_VERSION=11
ZHike_POSTGRES_MEMORY_LIMIT=2g
ZHike_POSTGRES_SHM_SIZE=256m
ZHike_API_MEMORY_LIMIT=1g
ZHike_AI_MEMORY_LIMIT=1g
ZHike_WS_MEMORY_LIMIT=1g
ZHike_BACKUP_MEMORY_LIMIT=512m
# Startup diagnostics warn and keep the stack degraded when free storage is
# below this threshold; no automatic deletion is performed.
ZHike_STORAGE_MIN_FREE_MB=2048
ZHike_MIGRATION_LOCK_TIMEOUT_SECONDS=30
ZHike_API_PORT=48080
ZHike_API_BIND=127.0.0.1
# Pairing is loopback-only by default. Only enable remote pairing on a
# private network and set a separate approval code; never reuse a database or
# connector secret. The desktop sends it via X-Zhike-Pairing-Approval.
ZHike_ALLOW_REMOTE_PAIRING=false
# Docker Desktop forwards local loopback traffic through a bridge. The
# compatibility path still requires the approval code below; disable it when
# binding beyond the local machine and use the approval-code path explicitly.
ZHike_ALLOW_DOCKER_LOOPBACK_PAIRING=true
# Must match the dedicated zhike_ingress subnet; do not widen this to a LAN CIDR.
ZHike_DOCKER_LOOPBACK_PAIRING_SOURCE_CIDR=172.31.240.0/24
# Required for Docker Desktop loopback pairing and remote pairing. Keep it
# local, random, and separate from the database/connector/AI secrets.
ZHIKE_PAIRING_APPROVAL_CODE=replace-with-a-random-local-proof
ZHIKE_API_TOKEN=
ZHIKE_API_TOKEN_FILE=
ZHIKE_CONNECTOR_ID=docker-default
ZHIKE_ACCOUNT_IDS=
ZHIKE_WS_URL=
ZHIKE_WS_HEADLESS=false
ZHike_WORKSPACE_OWNER_ID=
ZHike_AI_BASE_URL=
ZHike_AI_MODEL=gpt-5-mini
# Do not commit a key. Prefer a Docker secret or a local environment variable.
ZHike_AI_KEY=
ZHike_AI_KEY_FILE=
ZHike_BACKUP_INTERVAL_MINUTES=60
ZHike_BACKUP_RETENTION=14
