POSTGRES_DB=zhike
POSTGRES_USER=zhike_app
POSTGRES_PASSWORD=replace-with-a-local-secret
ZHike_APP_VERSION=5.0.0-dev
ZHike_SCHEMA_VERSION=8
ZHike_API_PORT=48080
ZHike_API_BIND=127.0.0.1
# Pairing is loopback-only by default. Only enable remote pairing on a
# private network and set a separate approval code; never reuse a database or
# connector secret. The desktop sends it via X-Zhike-Pairing-Approval.
ZHike_ALLOW_REMOTE_PAIRING=false
ZHIKE_PAIRING_APPROVAL_CODE=
ZHIKE_API_TOKEN=
ZHIKE_API_TOKEN_FILE=
ZHIKE_CONNECTOR_ID=docker-default
ZHIKE_ACCOUNT_IDS=
ZHIKE_WS_URL=
ZHIKE_WS_HEADLESS=false
ZHike_WORKSPACE_OWNER_ID=
ZHike_AI_BASE_URL=
ZHike_AI_MODEL=gpt-5-mini
# Do not commit a key. Prefer a Docker secret or a local environment variable.
ZHike_AI_KEY=
ZHike_AI_KEY_FILE=
ZHike_BACKUP_INTERVAL_MINUTES=60
ZHike_BACKUP_RETENTION=14
